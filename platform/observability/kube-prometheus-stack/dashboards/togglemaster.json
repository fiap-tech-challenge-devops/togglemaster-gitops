      "panels": []
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "CPU dos nós — uso não ocioso (%)",
      "description": "Percentual de tempo não ocioso da CPU, por instância do node-exporter.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
