      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "queryType": "range", "legendFormat": "{{service_name}}", "expr": "sum by (service_name) (rate({service_namespace=\"togglemaster\", service_name=\"analytics-service\"}[$__auto]))" }
      ]
    },

    {
      "id": 105,
      "type": "row",
      "title": "Recursos do cluster",
